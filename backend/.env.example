# Copiar como .env (nunca subir .env a git)
NODE_ENV=development
PORT=3000

# PostgreSQL local
DATABASE_URL="postgresql://centro:centro@localhost:5432/centro_integral?schema=public"

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:4200

# Base exclusiva para tests de integración (npm run test:e2e la migra y la vacía)
TEST_DATABASE_URL="postgresql://centro:centro@localhost:5432/centro_integral_test?schema=public"

# Firma de los access tokens (JWT): al menos 32 caracteres al azar.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR-por-una-clave-al-azar-de-al-menos-32-caracteres

# Clave maestra de las notas clínicas cifradas. Al azar, 32+ caracteres.
# Si se pierde o cambia, las notas guardadas no se pueden leer más.
DATOS_CLAVE_MAESTRA=CAMBIAR-por-una-clave-al-azar-de-al-menos-32-caracteres
# ACCESS_TOKEN_TTL_SEG=900
# REFRESH_TOKEN_TTL_DIAS=30

# Sin telemetría: la CLI de Prisma no consulta ni informa nada a sus servidores.
CHECKPOINT_DISABLE=1

# Contraseña de los usuarios demo (npm run db:demo). Solo desarrollo.
DEMO_PASSWORD=

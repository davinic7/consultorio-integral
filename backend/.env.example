# Copiar como .env (nunca subir .env a git)
NODE_ENV=development
PORT=3000

# PostgreSQL local
DATABASE_URL="postgresql://centro:centro@localhost:5432/centro_integral?schema=public"

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:4200

# Base exclusiva para tests de integración (npm run test:e2e la migra y la vacía)
TEST_DATABASE_URL="postgresql://centro:centro@localhost:5432/centro_integral_test?schema=public"

// Schema de Centro Integral. Ver docs/prototipo.md y docs/decisiones.md.
//
// Reglas multi-tenant:
//  1. Toda tabla con datos de un centro lleva centro_id.
//  2. Cada una declara @@unique([centroId, id]) y las relaciones entre ellas usan
//     claves foráneas compuestas (centro_id, x_id) -> (centro_id, id): PostgreSQL
//     rechaza cualquier referencia a una fila de otro centro.
//  3. La app consulta estas tablas solo a través del cliente con centro
//     (src/prisma/centro.ts), que agrega centro_id en cada consulta.
//
// Nombres: modelos y campos en camelCase, tablas y columnas en snake_case (@@map/@map).
// IDs: UUID v7 (ordenables por fecha, no enumerables, generables en el cliente móvil).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

/// Módulos que un plan puede habilitar.
enum Modulo {
  agenda
  asistencia
  pacientes
  cobros
  liquidacion
  reportes
  obras_sociales
  facturacion_arca
  /// Notas de sesión cifradas.
  notas
  /// Salas del centro y su asignación en la agenda.
  salas
  /// Dictado de notas por voz.
  dictado
  /// Cada profesional factura con su propio CUIT (requiere facturacion_arca).
  arca_por_profesional

  @@map("modulo")
}

/// Rol de un usuario dentro de un centro.
enum Rol {
  admin
  recepcion
  profesional

  @@map("rol")
}

enum TipoFinanciador {
  particular
  obra_social
  prepaga
  cud

  @@map("tipo_financiador")
}

enum EstadoAsistencia {
  pendiente
  presente
  ausente_con_aviso
  ausente_sin_aviso
  cancelado_profesional

  @@map("estado_asistencia")
}

/// Cómo se escribió una nota de sesión.
enum OrigenNota {
  escrita
  /// Dictada por voz: se transcribió y el profesional revisó el texto antes de guardarlo.
  dictada

  @@map("origen_nota")
}

enum MedioPago {
  efectivo
  transferencia
  tarjeta
  otro

  @@map("medio_pago")
}

/// Qué se cobra por un faltazo (regla de cada profesional).
enum ModoFaltazo {
  completa
  mitad
  fijo

  @@map("modo_faltazo")
}

/// Sesión atendida, o faltazo cobrado por la regla del profesional.
enum TipoPrestacion {
  sesion
  faltazo

  @@map("tipo_prestacion")
}

enum EstadoPago {
  pendiente
  cobrado
  rechazado

  @@map("estado_pago")
}

/// Cómo se conecta con ARCA: simulado no llama a ARCA (CAE ficticio, sin validez fiscal).
enum ModoArca {
  simulado
  homologacion
  produccion

  @@map("modo_arca")
}

enum EstadoFactura {
  emitida
  rechazada

  @@map("estado_factura")
}

enum EstadoLiquidacion {
  borrador
  cerrada
  pagada

  @@map("estado_liquidacion")
}

// ───────────────────────── Globales (sin centro) ─────────────────────────

model Plan {
  id               String       @id @default(uuid(7)) @db.Uuid
  codigo           String       @unique @db.VarChar(30)
  nombre           String       @db.VarChar(80)
  precioMensual    Decimal      @map("precio_mensual") @db.Decimal(12, 2)
  activo           Boolean      @default(true)
  /// Límites del plan; null = sin límite. Cuentan solo los activos.
  maxProfesionales Int?         @map("max_profesionales") @db.SmallInt
  maxSalas         Int?         @map("max_salas") @db.SmallInt
  /// Personas con acceso al centro (admin, recepción y profesionales).
  maxUsuarios      Int?         @map("max_usuarios") @db.SmallInt
  modulos          PlanModulo[]
  centros          Centro[]

  @@map("planes")
}

model PlanModulo {
  planId String @map("plan_id") @db.Uuid
  modulo Modulo
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, modulo])
  @@map("plan_modulos")
}

model Centro {
  id          String   @id @default(uuid(7)) @db.Uuid
  nombre      String   @db.VarChar(120)
  /// Identificador corto para URLs y login (ej. "centro-norte").
  slug        String   @unique @db.VarChar(60)
  planId      String   @map("plan_id") @db.Uuid
  zonaHoraria String   @default("America/Argentina/Catamarca") @map("zona_horaria") @db.VarChar(60)
  activo      Boolean  @default(true)
  /// Clave de datos del centro (AES-256) para cifrar notas clínicas, guardada
  /// cifrada con DATOS_CLAVE_MAESTRA. Se crea con la primera nota.
  claveDatos  String?  @map("clave_datos") @db.VarChar(200)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  plan              Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  miembros          Miembro[]
  profesionales     Profesional[]
  salas             Sala[]
  financiadores     Financiador[]
  pacientes         Paciente[]
  pacienteProfs     PacienteProfesional[]
  recurrencias      Recurrencia[]
  turnos            Turno[]
  prestaciones      Prestacion[]
  pagos             Pago[]
  liquidaciones     Liquidacion[]
  ordenes           Orden[]
  precios           Precio[]
  facturas          Factura[]
  acuerdosAlquiler  AcuerdoAlquiler[]
  configsFiscales   ConfigFiscal[]
  notasSesion       NotaSesion[]
  borradoresNota    BorradorNota[]
  cambiosAsistencia CambioAsistencia[]
  sesiones          Sesion[]
  avisos            Aviso[]

  @@map("centros")
}

/// Persona que inicia sesión. Puede pertenecer a varios centros (ver Miembro).
model Usuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Se guarda en minúsculas.
  email         String   @unique @db.VarChar(160)
  nombre        String   @db.VarChar(120)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  /// Superadministrador de la plataforma (DaviNic): gestiona centros y planes.
  esSuperadmin  Boolean  @default(false) @map("es_superadmin")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  miembros             Miembro[]
  profesionales        Profesional[]
  sesiones             Sesion[]
  prestacionesAnuladas Prestacion[]       @relation("PrestacionesAnuladas")
  turnosCreados        Turno[]            @relation("TurnosCreados")
  avisosRecibidos      Aviso[]            @relation("AvisosRecibidos")
  avisosEnviados       Aviso[]            @relation("AvisosEnviados")
  cambiosAsistencia    CambioAsistencia[]

  @@map("usuarios")
}

/// Sesión iniciada: guarda el hash del refresh token (rotación en cada uso).
/// Si llega un refresh token ya rotado, se asume robo y se revocan todas las sesiones del usuario.
model Sesion {
  id               String    @id @default(uuid(7)) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  /// Centro elegido en esta sesión (null: superadmin sin centro).
  centroId         String?   @map("centro_id") @db.Uuid
  /// SHA-256 del refresh token; el token en claro nunca se guarda.
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  creadaEn         DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  expiraEn         DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn       DateTime? @map("revocada_en") @db.Timestamptz(3)
  /// Sesión que la reemplazó al rotar el token.
  reemplazadaPorId String?   @map("reemplazada_por_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  centro  Centro? @relation(fields: [centroId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

// ───────────────────────── Datos de cada centro ─────────────────────────

/// Pertenencia de un usuario a un centro, con su rol.
model Miembro {
  id        String   @id @default(uuid(7)) @db.Uuid
  centroId  String   @map("centro_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  rol       Rol
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  centro  Centro  @relation(fields: [centroId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([centroId, id])
  @@unique([centroId, usuarioId])
  @@index([usuarioId])
  @@map("miembros")
}

model Profesional {
  id         String  @id @default(uuid(7)) @db.Uuid
  centroId   String  @map("centro_id") @db.Uuid
  /// Cuenta con la que inicia sesión (opcional: puede cargarse antes de tener acceso).
  usuarioId  String? @map("usuario_id") @db.Uuid
  nombre     String  @db.VarChar(80)
  apellido   String  @db.VarChar(80)
  disciplina String  @db.VarChar(80)
  matricula  String? @db.VarChar(40)
  /// Porcentaje de lo cobrado que le corresponde al profesional (0 a 100).
  /// Porcentaje de lo facturado (prestaciones del mes) que le corresponde al
  /// profesional (0 a 100). El resto es la retención del centro.
  activo     Boolean @default(true)

  centro                 Centro                @relation(fields: [centroId], references: [id], onDelete: Cascade)
  usuario                Usuario?              @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  pacientes              PacienteProfesional[]
  recurrencias           Recurrencia[]
  turnos                 Turno[]
  /// Regla de faltazo del profesional (apagada por defecto). Solo particulares.
  faltazoActivo          Boolean               @default(false) @map("faltazo_activo")
  /// Avisar con menos de estas horas cuenta como faltazo.
  faltazoToleranciaHoras Int                   @default(24) @map("faltazo_tolerancia_horas") @db.SmallInt
  faltazoModo            ModoFaltazo           @default(completa) @map("faltazo_modo")
  /// Monto del faltazo con modo "fijo".
  faltazoMonto           Decimal?              @map("faltazo_monto") @db.Decimal(12, 2)
  liquidaciones          Liquidacion[]
  acuerdos               AcuerdoAlquiler[]
  prestaciones           Prestacion[]
  notasSesion            NotaSesion[]
  borradoresNota         BorradorNota[]
  configFiscal           ConfigFiscal?
  facturas               Factura[]

  @@unique([centroId, id])
  @@unique([centroId, usuarioId])
  @@map("profesionales")
}

model Sala {
  id          String  @id @default(uuid(7)) @db.Uuid
  centroId    String  @map("centro_id") @db.Uuid
  nombre      String  @db.VarChar(80)
  descripcion String? @db.VarChar(255)
  activa      Boolean @default(true)

  centro       Centro        @relation(fields: [centroId], references: [id], onDelete: Cascade)
  recurrencias Recurrencia[]
  turnos       Turno[]

  @@unique([centroId, id])
  @@unique([centroId, nombre])
  @@map("salas")
}

/// Quién paga la sesión: obra social, prepaga, CUD o particular, con las reglas
/// de cada una. Las órdenes (tabla ordenes) y los tokens (en cada prestación) se
/// cargan desde cobros.
model Financiador {
  id                String          @id @default(uuid(7)) @db.Uuid
  centroId          String          @map("centro_id") @db.Uuid
  nombre            String          @db.VarChar(120)
  tipo              TipoFinanciador
  activo            Boolean         @default(true)
  /// Código de la prestación ante el financiador (ej. el código de OSEP).
  codigoPrestacion  String?         @map("codigo_prestacion") @db.VarChar(40)
  /// Cada sesión necesita una orden de autorización.
  requiereOrden     Boolean         @default(false) @map("requiere_orden")
  /// Cada sesión necesita un token (código que da el paciente).
  requiereToken     Boolean         @default(false) @map("requiere_token")
  /// Sesiones por semana que cubre (null: sin límite).
  maxSesionesSemana Int?            @map("max_sesiones_semana") @db.SmallInt
  /// Días de validez de una orden desde que se emite (null: no vence).
  diasValidezOrden  Int?            @map("dias_validez_orden") @db.SmallInt
  observaciones     String?         @db.VarChar(500)

  centro       Centro       @relation(fields: [centroId], references: [id], onDelete: Cascade)
  pacientes    Paciente[]
  prestaciones Prestacion[]
  ordenes      Orden[]
  precios      Precio[]

  @@unique([centroId, id])
  @@unique([centroId, nombre])
  @@map("financiadores")
}

model Paciente {
  id                  String    @id @default(uuid(7)) @db.Uuid
  centroId            String    @map("centro_id") @db.Uuid
  nombre              String    @db.VarChar(80)
  apellido            String    @db.VarChar(80)
  dni                 String?   @db.VarChar(15)
  fechaNacimiento     DateTime? @map("fecha_nacimiento") @db.Date
  telefono            String?   @db.VarChar(30)
  email               String?   @db.VarChar(160)
  /// Responsable o tutor (pacientes infantiles).
  responsableNombre   String?   @map("responsable_nombre") @db.VarChar(120)
  responsableTelefono String?   @map("responsable_telefono") @db.VarChar(30)
  financiadorId       String?   @map("financiador_id") @db.Uuid
  nroAfiliado         String?   @map("nro_afiliado") @db.VarChar(40)
  tieneCud            Boolean   @default(false) @map("tiene_cud")
  cudVencimiento      DateTime? @map("cud_vencimiento") @db.Date
  activo              Boolean   @default(true)
  creadoEn            DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  /// Nombre, apellido, DNI y teléfono sin tildes y en minúsculas, para buscar.
  /// Lo mantiene la app (src/common/texto.ts).
  busqueda            String    @default("") @db.VarChar(400)

  centro        Centro                @relation(fields: [centroId], references: [id], onDelete: Cascade)
  financiador   Financiador?          @relation(fields: [centroId, financiadorId], references: [centroId, id], onDelete: Restrict)
  profesionales PacienteProfesional[]
  recurrencias  Recurrencia[]
  turnos        Turno[]
  prestaciones  Prestacion[]
  ordenes       Orden[]
  precios       Precio[]
  facturas      Factura[]
  notasSesion   NotaSesion[]
  borradores    BorradorNota[]

  @@unique([centroId, id])
  @@unique([centroId, dni])
  @@index([centroId, apellido, nombre])
  @@index([busqueda(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("pacientes")
}

/// Profesionales que atienden a cada paciente (paciente compartido).
model PacienteProfesional {
  centroId      String @map("centro_id") @db.Uuid
  pacienteId    String @map("paciente_id") @db.Uuid
  profesionalId String @map("profesional_id") @db.Uuid

  centro      Centro      @relation(fields: [centroId], references: [id], onDelete: Cascade)
  paciente    Paciente    @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Cascade)
  profesional Profesional @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Cascade)

  @@id([centroId, pacienteId, profesionalId])
  @@index([centroId, profesionalId])
  @@map("paciente_profesional")
}

/// Turno que se repite cada semana (ej. todos los martes 10:00) hasta fechaHasta.
model Recurrencia {
  id            String    @id @default(uuid(7)) @db.Uuid
  centroId      String    @map("centro_id") @db.Uuid
  pacienteId    String    @map("paciente_id") @db.Uuid
  profesionalId String    @map("profesional_id") @db.Uuid
  salaId        String?   @map("sala_id") @db.Uuid
  /// 1 = lunes … 7 = domingo (ISO 8601).
  diaSemana     Int       @map("dia_semana") @db.SmallInt
  hora          DateTime  @db.Time(0)
  duracionMin   Int       @map("duracion_min") @db.SmallInt
  fechaDesde    DateTime  @map("fecha_desde") @db.Date
  fechaHasta    DateTime? @map("fecha_hasta") @db.Date

  centro      Centro      @relation(fields: [centroId], references: [id], onDelete: Cascade)
  paciente    Paciente    @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Cascade)
  profesional Profesional @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)
  sala        Sala?       @relation(fields: [centroId, salaId], references: [centroId, id], onDelete: Restrict)
  turnos      Turno[]

  @@unique([centroId, id])
  @@map("recurrencias")
}

model Turno {
  id               String           @id @default(uuid(7)) @db.Uuid
  centroId         String           @map("centro_id") @db.Uuid
  pacienteId       String           @map("paciente_id") @db.Uuid
  profesionalId    String           @map("profesional_id") @db.Uuid
  salaId           String?          @map("sala_id") @db.Uuid
  inicio           DateTime         @db.Timestamptz(0)
  fin              DateTime         @db.Timestamptz(0)
  recurrenciaId    String?          @map("recurrencia_id") @db.Uuid
  estadoAsistencia EstadoAsistencia @default(pendiente) @map("estado_asistencia")
  /// Ausente con aviso: si avisó con menos anticipación que la tolerancia del profesional.
  avisoTarde       Boolean?         @map("aviso_tarde")
  observaciones    String?          @db.VarChar(500)
  creadoEn         DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime         @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  /// Usuario que creó el turno.
  creadoPorId      String?          @map("creado_por_id") @db.Uuid

  centro            Centro             @relation(fields: [centroId], references: [id], onDelete: Cascade)
  creadoPor         Usuario?           @relation("TurnosCreados", fields: [creadoPorId], references: [id], onDelete: SetNull)
  avisos            Aviso[]
  paciente          Paciente           @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Restrict)
  profesional       Profesional        @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)
  sala              Sala?              @relation(fields: [centroId, salaId], references: [centroId, id], onDelete: Restrict)
  recurrencia       Recurrencia?       @relation(fields: [centroId, recurrenciaId], references: [centroId, id], onDelete: Restrict)
  prestacion        Prestacion?
  notasSesion       NotaSesion[]
  borradoresNota    BorradorNota[]
  cambiosAsistencia CambioAsistencia[]

  @@unique([centroId, id])
  @@index([centroId, inicio])
  @@index([centroId, profesionalId, inicio])
  @@index([centroId, salaId, inicio])
  @@index([centroId, pacienteId, inicio])
  // Además (en la migración, Prisma no los expresa): EXCLUDE de superposición por sala
  // y por profesional, sin contar turnos cancelados.
  @@map("turnos")
}

enum TipoAviso {
  turno_creado
  turno_movido
  turno_cancelado

  @@map("tipo_aviso")
}

/// Aviso para una persona del centro (hoy: cambios de agenda hechos por un profesional,
/// dirigidos a admin y recepción). Uno por destinatario, para saber quién lo leyó.
model Aviso {
  id             String    @id @default(uuid(7)) @db.Uuid
  centroId       String    @map("centro_id") @db.Uuid
  destinatarioId String    @map("destinatario_id") @db.Uuid
  autorId        String?   @map("autor_id") @db.Uuid
  tipo           TipoAviso
  mensaje        String    @db.VarChar(400)
  turnoId        String?   @map("turno_id") @db.Uuid
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  leidoEn        DateTime? @map("leido_en") @db.Timestamptz(3)

  centro       Centro   @relation(fields: [centroId], references: [id], onDelete: Cascade)
  destinatario Usuario  @relation("AvisosRecibidos", fields: [destinatarioId], references: [id], onDelete: Cascade)
  autor        Usuario? @relation("AvisosEnviados", fields: [autorId], references: [id], onDelete: SetNull)
  turno        Turno?   @relation(fields: [centroId, turnoId], references: [centroId, id], onDelete: Restrict)

  @@unique([centroId, id])
  @@index([centroId, destinatarioId, leidoEn, creadoEn])
  @@map("avisos")
}

/// Registro de cada cambio de asistencia de un turno: quién, cuándo y de qué a qué.
model CambioAsistencia {
  id             String           @id @default(uuid(7)) @db.Uuid
  centroId       String           @map("centro_id") @db.Uuid
  turnoId        String           @map("turno_id") @db.Uuid
  estadoAnterior EstadoAsistencia @map("estado_anterior")
  estadoNuevo    EstadoAsistencia @map("estado_nuevo")
  usuarioId      String?          @map("usuario_id") @db.Uuid
  creadoEn       DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)

  centro  Centro   @relation(fields: [centroId], references: [id], onDelete: Cascade)
  turno   Turno    @relation(fields: [centroId, turnoId], references: [centroId, id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([centroId, id])
  @@index([centroId, turnoId, creadoEn])
  @@map("cambios_asistencia")
}

/// Sesión asistida que se cobra o factura. Una por turno presente: se crea al
/// marcar "presente" y se borra si la asistencia se corrige (sin pagos ni factura).
model Prestacion {
  id              String         @id @default(uuid(7)) @db.Uuid
  centroId        String         @map("centro_id") @db.Uuid
  turnoId         String         @map("turno_id") @db.Uuid
  tipo            TipoPrestacion @default(sesion)
  /// Copiados del turno para filtrar y liquidar sin pasar por turnos.
  pacienteId      String         @map("paciente_id") @db.Uuid
  profesionalId   String         @map("profesional_id") @db.Uuid
  /// Quién paga. null: particular.
  financiadorId   String?        @map("financiador_id") @db.Uuid
  /// Día de la sesión en la zona del centro.
  fecha           DateTime       @db.Date
  /// Primer día del mes al que corresponde (ej. 2026-11-01).
  periodo         DateTime       @db.Date
  monto           Decimal        @db.Decimal(12, 2)
  /// El monto se cargó a mano: los cambios de precio no lo tocan.
  montoManual     Boolean        @default(false) @map("monto_manual")
  /// Presentada a la obra social o con factura emitida.
  facturada       Boolean        @default(false)
  /// Orden de autorización que cubre la sesión (si el financiador la pide).
  ordenId         String?        @map("orden_id") @db.Uuid
  /// Token que da el paciente en cada sesión (si el financiador lo pide).
  token           String?        @db.VarChar(20)
  /// Fecha que se declara a la obra social (puede diferir de la real por sus reglas).
  fechaDeclarada  DateTime?      @map("fecha_declarada") @db.Date
  /// Factura electrónica que la incluye (particulares).
  facturaId       String?        @map("factura_id") @db.Uuid
  creadaEn        DateTime       @default(now()) @map("creada_en") @db.Timestamptz(3)
  /// Faltazo anulado (por recepción, el profesional o la administración): no se cobra ni se liquida.
  anuladaEn       DateTime?      @map("anulada_en") @db.Timestamptz(3)
  anuladaPorId    String?        @map("anulada_por_id") @db.Uuid
  motivoAnulacion String?        @map("motivo_anulacion") @db.VarChar(200)

  centro      Centro       @relation(fields: [centroId], references: [id], onDelete: Cascade)
  anuladaPor  Usuario?     @relation("PrestacionesAnuladas", fields: [anuladaPorId], references: [id], onDelete: SetNull)
  turno       Turno        @relation(fields: [centroId, turnoId], references: [centroId, id], onDelete: Restrict)
  paciente    Paciente     @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Restrict)
  profesional Profesional  @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)
  financiador Financiador? @relation(fields: [centroId, financiadorId], references: [centroId, id], onDelete: Restrict)
  orden       Orden?       @relation(fields: [centroId, ordenId], references: [centroId, id], onDelete: Restrict)
  factura     Factura?     @relation(fields: [centroId, facturaId], references: [centroId, id], onDelete: Restrict)
  pagos       Pago[]

  @@unique([centroId, id])
  @@unique([centroId, turnoId])
  @@index([centroId, periodo, profesionalId])
  @@index([centroId, pacienteId, fecha])
  @@index([centroId, ordenId])
  @@map("prestaciones")
}

/// Pago de una prestación: lo que paga el paciente o lo que liquida la obra social.
model Pago {
  id            String     @id @default(uuid(7)) @db.Uuid
  centroId      String     @map("centro_id") @db.Uuid
  prestacionId  String     @map("prestacion_id") @db.Uuid
  monto         Decimal    @db.Decimal(12, 2)
  fecha         DateTime   @db.Date
  medio         MedioPago
  estado        EstadoPago @default(pendiente)
  observaciones String?    @db.VarChar(200)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)

  centro     Centro     @relation(fields: [centroId], references: [id], onDelete: Cascade)
  prestacion Prestacion @relation(fields: [centroId, prestacionId], references: [centroId, id], onDelete: Restrict)

  @@unique([centroId, id])
  @@index([centroId, fecha])
  @@index([centroId, prestacionId])
  @@map("pagos")
}

/// Orden de autorización de una obra social para un paciente: cubre una cantidad
/// de sesiones desde la emisión hasta el vencimiento.
model Orden {
  id            String    @id @default(uuid(7)) @db.Uuid
  centroId      String    @map("centro_id") @db.Uuid
  pacienteId    String    @map("paciente_id") @db.Uuid
  financiadorId String    @map("financiador_id") @db.Uuid
  numero        String    @db.VarChar(40)
  fechaEmision  DateTime  @map("fecha_emision") @db.Date
  /// Último día en que vale (null: no vence). Se calcula con los días de validez
  /// del financiador, y se puede corregir.
  vence         DateTime? @db.Date
  /// Sesiones que autoriza.
  sesiones      Int       @db.SmallInt
  observaciones String?   @db.VarChar(200)
  creadaEn      DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)

  centro       Centro       @relation(fields: [centroId], references: [id], onDelete: Cascade)
  paciente     Paciente     @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Restrict)
  financiador  Financiador  @relation(fields: [centroId, financiadorId], references: [centroId, id], onDelete: Restrict)
  prestaciones Prestacion[]

  @@unique([centroId, id])
  @@unique([centroId, financiadorId, numero])
  @@index([centroId, pacienteId, fechaEmision])
  @@map("ordenes")
}

/// Valor de la sesión desde una fecha (historial: no se pisa, se agrega uno nuevo).
/// Sin paciente: valor general de la obra social (o de particular, sin financiador).
/// Con paciente: precio especial de ese paciente con esa cobertura.
model Precio {
  id            String   @id @default(uuid(7)) @db.Uuid
  centroId      String   @map("centro_id") @db.Uuid
  financiadorId String?  @map("financiador_id") @db.Uuid
  pacienteId    String?  @map("paciente_id") @db.Uuid
  monto         Decimal  @db.Decimal(12, 2)
  vigenteDesde  DateTime @map("vigente_desde") @db.Date
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  centro      Centro       @relation(fields: [centroId], references: [id], onDelete: Cascade)
  financiador Financiador? @relation(fields: [centroId, financiadorId], references: [centroId, id], onDelete: Restrict)
  paciente    Paciente?    @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Cascade)

  @@unique([centroId, id])
  @@index([centroId, financiadorId, pacienteId, vigenteDesde])
  @@map("precios")
}

/// Liquidación mensual de un profesional. Al generarla queda "cerrada": guarda los
/// totales y ya no se puede cambiar la asistencia ni los montos de ese mes.
model Liquidacion {
  id              String            @id @default(uuid(7)) @db.Uuid
  centroId        String            @map("centro_id") @db.Uuid
  profesionalId   String            @map("profesional_id") @db.Uuid
  /// Primer día del mes liquidado.
  periodo         DateTime          @db.Date
  sesiones        Int               @default(0)
  /// Lo facturado en el mes por las sesiones del profesional.
  totalBruto      Decimal           @map("total_bruto") @db.Decimal(12, 2)
  /// Lo que el profesional le debe al centro por su acuerdo de alquiler.
  alquiler        Decimal           @default(0) @db.Decimal(12, 2)
  /// Copia del cálculo al cerrar: acuerdo, componentes, bases y montos.
  detalleAlquiler Json?             @map("detalle_alquiler")
  /// Si el centro cobra a los pacientes por el profesional (si no, cobra él).
  cobraElCentro   Boolean           @default(true) @map("cobra_el_centro")
  /// Saldo: positivo, el centro le paga al profesional; negativo, el profesional le debe al centro.
  totalLiquidado  Decimal           @map("total_liquidado") @db.Decimal(12, 2)
  estado          EstadoLiquidacion @default(borrador)
  cerradaEn       DateTime?         @map("cerrada_en") @db.Timestamptz(3)
  pagadaEn        DateTime?         @map("pagada_en") @db.Timestamptz(3)

  centro      Centro      @relation(fields: [centroId], references: [id], onDelete: Cascade)
  profesional Profesional @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)

  @@unique([centroId, id])
  @@unique([centroId, profesionalId, periodo])
  @@map("liquidaciones")
}

/// Acuerdo de alquiler entre el centro y un profesional, vigente desde un mes.
/// Lo que el profesional debe en el mes es la suma de los componentes cargados
/// (todos opcionales): cuota fija, porcentaje de lo facturado, monto por sesión
/// atendida, monto por hora de sala y el equivalente a N sesiones (al precio
/// particular vigente). Un cambio es una fila nueva: los meses ya liquidados
/// guardaron su cálculo y no cambian.
model AcuerdoAlquiler {
  id                   String   @id @default(uuid(7)) @db.Uuid
  centroId             String   @map("centro_id") @db.Uuid
  profesionalId        String   @map("profesional_id") @db.Uuid
  /// Primer día del mes desde el que rige.
  vigenteDesde         DateTime @map("vigente_desde") @db.Date
  montoFijo            Decimal? @map("monto_fijo") @db.Decimal(12, 2)
  /// Porcentaje de lo facturado por el profesional en el mes.
  porcentaje           Decimal? @db.Decimal(5, 2)
  montoPorSesion       Decimal? @map("monto_por_sesion") @db.Decimal(12, 2)
  /// Por hora de turnos atendidos en una sala.
  montoPorHora         Decimal? @map("monto_por_hora") @db.Decimal(12, 2)
  /// Cuota equivalente a N sesiones al precio particular vigente.
  sesionesEquivalentes Int?     @map("sesiones_equivalentes") @db.SmallInt
  /// Si el centro cobra a los pacientes por el profesional y le liquida lo suyo.
  cobraElCentro        Boolean  @default(true) @map("cobra_el_centro")
  nota                 String?  @db.VarChar(200)
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  centro      Centro      @relation(fields: [centroId], references: [id], onDelete: Cascade)
  profesional Profesional @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Cascade)

  @@unique([centroId, id])
  @@unique([centroId, profesionalId, vigenteDesde])
  @@map("acuerdos_alquiler")
}

/// Datos fiscales de un emisor: el centro (profesionalId null, una fila por centro)
/// o un profesional que factura con su propio CUIT.
/// La clave privada se guarda cifrada con la clave de datos del centro.
model ConfigFiscal {
  id                     String    @id @default(uuid(7)) @db.Uuid
  centroId               String    @map("centro_id") @db.Uuid
  /// null: datos del centro. Con valor: los del profesional.
  profesionalId          String?   @map("profesional_id") @db.Uuid
  /// 11 dígitos, sin guiones.
  cuit                   String?   @db.VarChar(11)
  razonSocial            String?   @map("razon_social") @db.VarChar(120)
  domicilio              String?   @db.VarChar(200)
  inicioActividades      DateTime? @map("inicio_actividades") @db.Date
  /// Punto de venta "RECE para aplicativo y web services".
  ptoVta                 Int       @default(1) @map("pto_vta") @db.SmallInt
  modo                   ModoArca  @default(simulado)
  /// Descripción del ítem de la factura.
  textoItem              String    @default("Honorarios por sesión") @map("texto_item") @db.VarChar(200)
  clavePrivada           String?   @map("clave_privada")
  certificado            String?
  certificadoVence       DateTime? @map("certificado_vence") @db.Timestamptz(3)
  /// Ticket de acceso de WSAA (dura 12 h): se reutiliza mientras vale.
  ticketToken            String?   @map("ticket_token")
  ticketSign             String?   @map("ticket_sign")
  ticketVence            DateTime? @map("ticket_vence") @db.Timestamptz(3)
  ticketModo             ModoArca? @map("ticket_modo")
  /// Solo en la fila del centro: cada profesional factura sus sesiones con sus datos.
  facturaCadaProfesional Boolean   @default(false) @map("factura_cada_profesional")

  centro      Centro       @relation(fields: [centroId], references: [id], onDelete: Cascade)
  profesional Profesional? @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Cascade)
  facturas    Factura[]

  @@unique([centroId, id])
  /// Un emisor por profesional. La fila única del centro (profesional_id null) la
  /// asegura un índice parcial en la migración.
  @@unique([centroId, profesionalId])
  @@map("config_fiscal")
}

/// Factura C (monotributo) a un paciente particular por las sesiones de un mes.
model Factura {
  id             String        @id @default(uuid(7)) @db.Uuid
  centroId       String        @map("centro_id") @db.Uuid
  pacienteId     String        @map("paciente_id") @db.Uuid
  /// Emisor: datos fiscales con los que se emitió (del centro o de un profesional).
  configFiscalId String        @map("config_fiscal_id") @db.Uuid
  /// Profesional de las sesiones, si factura cada profesional.
  profesionalId  String?       @map("profesional_id") @db.Uuid
  /// Primer día del mes de las sesiones.
  periodo        DateTime      @db.Date
  fecha          DateTime      @db.Date
  ptoVta         Int           @map("pto_vta") @db.SmallInt
  /// 11 = Factura C.
  cbteTipo       Int           @default(11) @map("cbte_tipo") @db.SmallInt
  numero         Int?
  /// 96 = DNI, 99 = consumidor final sin identificar.
  docTipo        Int           @map("doc_tipo") @db.SmallInt
  docNro         String        @map("doc_nro") @db.VarChar(11)
  total          Decimal       @db.Decimal(12, 2)
  /// Ítems: [{ descripcion, cantidad, precio }].
  detalle        Json
  cae            String?       @db.VarChar(20)
  caeVence       DateTime?     @map("cae_vence") @db.Date
  modo           ModoArca
  estado         EstadoFactura
  error          String?       @db.VarChar(1000)
  /// Ya se le mandó al paciente.
  enviada        Boolean       @default(false)
  creadaEn       DateTime      @default(now()) @map("creada_en") @db.Timestamptz(3)

  centro       Centro       @relation(fields: [centroId], references: [id], onDelete: Cascade)
  paciente     Paciente     @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Restrict)
  emisor       ConfigFiscal @relation(fields: [centroId, configFiscalId], references: [centroId, id], onDelete: Restrict)
  profesional  Profesional? @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)
  prestaciones Prestacion[]

  @@unique([centroId, id])
  /// Numeración de ARCA: por emisor (CUIT), punto de venta y tipo.
  @@unique([configFiscalId, modo, ptoVta, cbteTipo, numero])
  @@index([centroId, periodo])
  @@map("facturas")
}

/// Nota clínica. Privada del profesional salvo que se comparta con el equipo.
/// El texto se guarda cifrado con la clave de datos del centro (AES-256-GCM,
/// src/notas/cifrado.ts); la base nunca tiene el texto en claro.
model NotaSesion {
  id            String     @id @default(uuid(7)) @db.Uuid
  centroId      String     @map("centro_id") @db.Uuid
  turnoId       String?    @map("turno_id") @db.Uuid
  pacienteId    String     @map("paciente_id") @db.Uuid
  profesionalId String     @map("profesional_id") @db.Uuid
  texto         String
  compartida    Boolean    @default(false)
  origen        OrigenNota @default(escrita)
  creadaEn      DateTime   @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn DateTime   @default(now()) @updatedAt @map("actualizada_en") @db.Timestamptz(3)
  /// Última vez que cambió el texto. Cambiar la visibilidad no cuenta como edición.
  editadaEn     DateTime?  @map("editada_en") @db.Timestamptz(3)

  centro      Centro      @relation(fields: [centroId], references: [id], onDelete: Cascade)
  turno       Turno?      @relation(fields: [centroId, turnoId], references: [centroId, id], onDelete: Restrict)
  paciente    Paciente    @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Restrict)
  profesional Profesional @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)

  @@unique([centroId, id])
  @@index([centroId, pacienteId, creadaEn])
  @@map("notas_sesion")
}

/// Evolución que el profesional todavía no guardó: lo que va escribiendo o lo que
/// volvió del dictado, para revisarlo. Una por profesional y paciente. Vive en el
/// servidor (no en el teléfono), cifrada como las notas, y la ve solo su autor.
/// Al guardar la evolución se borra; si nadie lo toca en 30 días, también
/// (src/notas/borradores-vencidos.ts).
model BorradorNota {
  id            String     @id @default(uuid(7)) @db.Uuid
  centroId      String     @map("centro_id") @db.Uuid
  pacienteId    String     @map("paciente_id") @db.Uuid
  profesionalId String     @map("profesional_id") @db.Uuid
  turnoId       String?    @map("turno_id") @db.Uuid
  /// Cifrado con la clave de datos del centro, como NotaSesion.texto.
  texto         String
  compartida    Boolean    @default(false)
  origen        OrigenNota @default(escrita)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime   @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  centro      Centro      @relation(fields: [centroId], references: [id], onDelete: Cascade)
  paciente    Paciente    @relation(fields: [centroId, pacienteId], references: [centroId, id], onDelete: Restrict)
  profesional Profesional @relation(fields: [centroId, profesionalId], references: [centroId, id], onDelete: Restrict)
  /// Un borrador nunca impide borrar su turno: queda sin turno y sigue siendo del
  /// paciente. En la base es ON DELETE SET NULL ("turno_id"), solo esa columna
  /// (PostgreSQL 15+). Prisma avisa porque centroId es obligatorio: es esperado.
  turno       Turno?      @relation(fields: [centroId, turnoId], references: [centroId, id], onDelete: SetNull)

  @@unique([centroId, id])
  @@unique([centroId, pacienteId, profesionalId])
  @@map("borradores_nota")
}
